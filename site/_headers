# Header rules for the Pages project (still called tuck, serving duck.hellodigitworks.com).

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# The worker decides when everything else updates, so it must never be served stale.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# The feed decides when Duck updates itself, so it must never be served stale either.
/appcast.xml
  Cache-Control: public, max-age=0, must-revalidate

# Fonts never change under the same name.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
